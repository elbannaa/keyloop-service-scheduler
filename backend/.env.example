# Application
NODE_ENV=development
APP_NAME="MYNM Service Booking Discovery"
PORT=3001

# Safety guard. Keep true during discovery and UAT preparation.
# SAFE_MODE=true forces outbound mail off even if MAIL_MODE is changed.
SAFE_MODE=true

# Database and cache
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Authentication
# Required. Use a randomly generated value of at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Booking-engine settings
# These values preserve the repository's current demo behavior only.
# They are not asserted as approved MYNM operating rules.
BOOKING_SLOT_MINUTES=15
BOOKING_MAX_DURATION_MINUTES=240
BOOKING_RESOURCE_CACHE_TTL_SECONDS=3600

# Seed administrator
# Supply approved test credentials locally. Do not commit real credentials.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Frontend
FRONTEND_URL=http://localhost:5173

# Outbound mail
# Allowed values: disabled, log, smtp. Keep disabled until MYNM approves the sender and domains.
MAIL_MODE=disabled
MAIL_ALLOWED_DOMAINS=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
