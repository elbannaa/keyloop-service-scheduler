generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  name         String
  role         Role         @default(USER)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  managedDealerships Dealership[] @relation("DealershipManager")

  @@map("users")
}

model Dealership {
  id          String       @id @default(uuid())
  name        String
  address     String
  isActive    Boolean      @default(true) @map("is_active")
  managerId   String?      @map("manager_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  manager     User?        @relation("DealershipManager", fields: [managerId], references: [id])
  technicians Technician[]
  vehicles    Vehicle[]
  appointments Appointment[]

  @@map("dealerships")
}

model Technician {
  id           String     @id @default(uuid())
  name         String
  isActive     Boolean    @default(true) @map("is_active")
  dealershipId String     @map("dealership_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  dealership   Dealership @relation(fields: [dealershipId], references: [id])
  appointments Appointment[]

  @@map("technicians")
}

model Vehicle {
  id           String     @id @default(uuid())
  make         String
  model        String
  year         Int
  dealershipId String     @map("dealership_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  dealership   Dealership @relation(fields: [dealershipId], references: [id])
  appointments Appointment[]

  @@map("vehicles")
}

enum ServiceType {
  SALES_CONSULTATION
  DETAILED_CONSULTATION
  REPAIR_MAINTENANCE
}

model Appointment {
  id              String      @id @default(uuid())
  serviceType     ServiceType @map("service_type")
  startTime       DateTime    @map("start_time")
  endTime         DateTime    @map("end_time")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  vehicleInfo     String?     @map("vehicle_info")
  
  dealershipId    String      @map("dealership_id")
  technicianId    String      @map("technician_id")
  vehicleId       String?     @map("vehicle_id")
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  dealership      Dealership  @relation(fields: [dealershipId], references: [id])
  technician      Technician  @relation(fields: [technicianId], references: [id])
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])

  @@map("appointments")
}
