# Keep enabled during local discovery and UAT preparation.
VITE_SAFE_MODE=true

# Relative by default so the browser only calls the same application origin/proxy.
VITE_API_BASE_URL=/api

# Comma-separated hostnames explicitly approved for browser API calls.
# Leave blank for local discovery. Do not add production hosts without MYNM approval.
VITE_ALLOWED_API_HOSTS=
